{
  "description": "Update Team Graph after an Agent runs Git commands.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.team-graph/hooks/team-graph-polyhook.cjs\"",
            "commandWindows": "node \"$(git rev-parse --show-toplevel)/.team-graph/hooks/team-graph-polyhook.cjs\"",
            "async": true,
            "timeout": 120,
            "statusMessage": "同步 Team Graph 状态"
          }
        ]
      }
    ]
  }
}
