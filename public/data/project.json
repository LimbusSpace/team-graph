      "phase": "P3 主张",
      "status": "planned",
      "ownerIds": [
        "fei",
        "zhang",
        "ma",
        "deng"
      ],
      "acceptanceCriteria": "同等人类录制时长下，主方法相对覆盖驱动、合成和筛选基线取得预注册指标上的显著提升。",
      "weight": 3,
      "lane": 2,
      "updatedAt": "2026-09-05T09:50:00+08:00"
    },
    {
